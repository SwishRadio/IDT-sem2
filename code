// ==================== HEARTBEAT SENSOR HANDLER ====================
void IRAM_ATTR heartbeatISR() {
  unsigned long now = micros();
  static unsigned long lastDebounceTime = 0;
  
  // Debounce: ignore pulses within 250ms
  if ((now - lastDebounceTime) > 250000) {
    beatInterval = now - lastBeatTime;
    lastBeatTime = now;
    newBeatAvailable = true;
    lastDebounceTime = now;
  }
}

// Calculate BPM from beat intervals
float calculateBPM() {
  if (beatInterval > 0 && beatInterval < 2000000) {  // Valid between 30-300 BPM
    float instantBPM = 60000000.0 / beatInterval;
    if (instantBPM >= 30 && instantBPM <= 250) {
      // Moving average filter
      bpmBuffer[bpmBufferIndex] = (int)instantBPM;
      bpmBufferIndex = (bpmBufferIndex + 1) % BPM_SAMPLE_SIZE;
      
      int sum = 0;
      int count = 0;
      for (int i = 0; i < BPM_SAMPLE_SIZE; i++) {
        if (bpmBuffer[i] > 0) {
          sum += bpmBuffer[i];
          count++;
        }
      }
      return (count > 0) ? (float)(sum / count) : 0;
    }
  }
  return sensor.heartRate;  // Return last valid value
}

// ==================== TEMPERATURE SENSOR ====================
float readTemperature() {
  ds18b20.requestTemperatures();
  float temp = ds18b20.getTempCByIndex(0);
  
  if (temp == DEVICE_DISCONNECTED_C || temp < -20 || temp > 100) {
    status.tempOk = false;
    status.errorMessages = "DS18B20 not detected!";
    Serial.println("[ERROR] Temperature sensor not found!");
    return sensor.temperature;  // Return last valid value
  }
  
  // Moving average filter
  tempBuffer[tempBufferIndex] = temp;
  tempBufferIndex = (tempBufferIndex + 1) % TEMP_SAMPLE_SIZE;
  
  float sum = 0;
  int count = 0;
  for (int i = 0; i < TEMP_SAMPLE_SIZE; i++) {
    if (tempBuffer[i] > -50) {
      sum += tempBuffer[i];
      count++;
    }
  }
  
  status.tempOk = true;
  return (count > 0) ? (sum / count) : temp;
}

// ==================== MPU6050 INITIALIZATION ====================
bool initMPU6050() {
  Wire.begin(21, 22);  // SDA=GPIO21, SCL=GPIO22
  Wire.setClock(400000);
  delay(100);
  
  mpu.begin();
  mpu.calcGyroOffsets(true);
  delay(1000);
  
  status.mpuOk = true;
  Serial.println("[INFO] MPU6050 initialized successfully");
  return true;
}

// ==================== FALL DETECTION ====================
void updateFallDetection() {
  if (!status.mpuOk) return;
  
  mpu.update();  // Read latest data
  
  sensor.accelX = mpu.getAccX();
  sensor.accelY = mpu.getAccY();
  sensor.accelZ = mpu.getAccZ();
  sensor.gyroX = mpu.getGyroX();
  sensor.gyroY = mpu.getGyroY();
  sensor.gyroZ = mpu.getGyroZ();
  
  // Calculate total acceleration magnitude
  float accelMagnitude = sqrt(
    sq(sensor.accelX) + 
    sq(sensor.accelY) + 
    sq(sensor.accelZ)
  );
  
  // Fall detection logic
  static unsigned long impactTime = 0;
  static bool potentialFall = false;
  
  if (accelMagnitude > FALL_ACCEL_THRESHOLD && !sensor.fallDetected) {
    if (!potentialFall) {
      potentialFall = true;
      impactTime = millis();
      Serial.printf("[FALL] Impact detected! Magnitude: %.2f m/s^2\n", accelMagnitude);
    }
  }
  
  // Check for post-fall inactivity (lying still)
  if (potentialFall && !sensor.fallDetected) {
    unsigned long timeSinceImpact = millis() - impactTime;
    if (timeSinceImpact > 1000 && accelMagnitude < 11.0) {  // < 1.1g for 1 second
      sensor.fallDetected = true;
      sensor.emergencyActive = true;
      potentialFall = false;
      Serial.println("[ALERT] FALL DETECTED! Medical assistance may be needed!");
    } else if (timeSinceImpact > 3000 && accelMagnitude > 15.0) {
      // False alarm - person moved quickly after impact
      potentialFall = false;
      Serial.println("[INFO] Fall impact detected but person moved - probable false alarm");
    }
  }
  
  // Auto-clear fall after recovery time
  if (sensor.fallDetected && (millis() - impactTime) > FALL_RECOVERY_TIME) {
    sensor.fallDetected = false;
    Serial.println("[INFO] Fall alert auto-cleared after recovery period");
  }
}

// ==================== EMERGENCY CHECKING ====================
void checkEmergencyConditions() {
  unsigned long now = millis();
  bool newEmergency = false;
  String emergencyReason = "";
  
  // Heart rate check
  if (status.heartbeatOk && sensor.heartRate > 0) {
    if (sensor.heartRate < HEART_RATE_MIN) {
      if (now - lastHeartAlert > EMERGENCY_COOLDOWN) {
        newEmergency = true;
        emergencyReason = "LOW HEART RATE: " + String(sensor.heartRate, 0) + " BPM";
        lastHeartAlert = now;
      }
    } else if (sensor.heartRate > HEART_RATE_MAX) {
      if (now - lastHeartAlert > EMERGENCY_COOLDOWN) {
        newEmergency = true;
        emergencyReason = "HIGH HEART RATE: " + String(sensor.heartRate, 0) + " BPM";
        lastHeartAlert = now;
      }
    }
  }
  
  // Temperature check
  if (status.tempOk && sensor.temperature > -50) {
    if (sensor.temperature < TEMP_MIN) {
      if (now - lastTempAlert > EMERGENCY_COOLDOWN) {
        newEmergency = true;
        emergencyReason = "LOW TEMPERATURE: " + String(sensor.temperature, 1) + "C";
        lastTempAlert = now;
      }
    } else if (sensor.temperature > TEMP_MAX) {
      if (now - lastTempAlert > EMERGENCY_COOLDOWN) {
        newEmergency = true;
        emergencyReason = "HIGH TEMPERATURE: " + String(sensor.temperature, 1) + "C";
        lastTempAlert = now;
      }
    }
  }
  
  // Fall check
  if (sensor.fallDetected && (now - lastFallAlert > EMERGENCY_COOLDOWN)) {
    newEmergency = true;
    emergencyReason = "FALL DETECTED - Person may be injured!";
    lastFallAlert = now;
  }
  
  if (newEmergency) {
    sensor.emergencyActive = true;
    lastEmergencyTime = now;
    Serial.println("\n!!! MEDICAL EMERGENCY !!!");
    Serial.println(emergencyReason);
    Serial.println("!!! PLEASE CHECK ON PATIENT IMMEDIATELY !!!\n");
  }
  
  // Auto-clear emergencies after cooldown if vitals normalize
  if (sensor.emergencyActive && !sensor.fallDetected && (now - lastEmergencyTime > EMERGENCY_COOLDOWN)) {
    bool vitalsNormal = true;
    if (status.heartbeatOk && sensor.heartRate > 0) {
      vitalsNormal &= (sensor.heartRate >= HEART_RATE_MIN && sensor.heartRate <= HEART_RATE_MAX);
    }
    if (status.tempOk && sensor.temperature > -50) {
      vitalsNormal &= (sensor.temperature >= TEMP_MIN && sensor.temperature <= TEMP_MAX);
    }
    
    if (vitalsNormal) {
      sensor.emergencyActive = false;
      Serial.println("[INFO] Emergency cleared - vitals have normalized");
    }
  }
}

