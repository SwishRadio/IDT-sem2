// Medical thresholds (more forgiving)
const int   HEART_RATE_MIN   = 45;    // BPM – bradycardia
const int   HEART_RATE_MAX   = 130;   // BPM – tachycardia
const float TEMP_MIN         = 35.0f; // °C  – mild hypothermia boundary
const float TEMP_MAX         = 39.5f; // °C  – high fever boundary

// Fall detection tuning
const float FREEFALL_THRESHOLD   = 3.0f;   // m/s² – near-zero g = free-fall
const float IMPACT_THRESHOLD     = 28.0f;  // m/s² – hard impact after free-fall
const float INACTIVITY_THRESHOLD = 10.5f;  // m/s² – ~1 g, lying still
const unsigned long FREEFALL_WINDOW    = 120;   // ms  – max free-fall duration
const unsigned long IMPACT_WINDOW      = 800;   // ms  – look for impact after FF
const unsigned long INACTIVITY_WINDOW  = 1500;  // ms  – inactivity confirms fall
const unsigned long FALL_RECOVERY_TIME = 10000; // ms  – auto-clear if no alert
const unsigned long EMERGENCY_COOLDOWN = 25000; // ms  – min gap between alerts

// Smoothing
const int BPM_SAMPLE_SIZE  = 12;
const int TEMP_SAMPLE_SIZE = 6;

// History buffer for graphs (60 data points ≈ 60 s)
const int HISTORY_SIZE = 60;

// ==================== PINS ====================
#define HEARTBEAT_PIN  34
#define ONE_WIRE_BUS    4

// ==================== OBJECTS ====================
WebServer         server(80);
OneWire           oneWire(ONE_WIRE_BUS);
DallasTemperature ds18b20(&oneWire);
MPU6050           mpu(Wire);

// ==================== DATA STRUCTURES ====================
struct SensorData {
  float heartRate   = 0.0f;
  float temperature = 0.0f;
  bool  fallDetected    = false;
  bool  emergencyActive = false;
  float accelMag = 0.0f;           // current total acceleration magnitude
  float accelX = 0, accelY = 0, accelZ = 0;
  float gyroX  = 0, gyroY  = 0, gyroZ  = 0;
  unsigned long lastUpdate = 0;
};

struct SensorStatus {
  bool   heartbeatOk = false;
  bool   tempOk      = false;
  bool   mpuOk       = false;
  bool   wifiOk      = false;
  String errorMessages = "";
};

struct HistoryBuffer {
  float bpm[HISTORY_SIZE];
  float temp[HISTORY_SIZE];
  int   head = 0;
  int   count = 0;
  HistoryBuffer() {
    memset(bpm,  0, sizeof(bpm));
    memset(temp, 0, sizeof(temp));
  }
  void push(float b, float t) {
    bpm[head]  = b;
    temp[head] = t;
    head = (head + 1) % HISTORY_SIZE;
    if (count < HISTORY_SIZE) count++;
  }
};

// ==================== GLOBALS ====================
SensorData    sensor;
SensorStatus  sensorStatus;
HistoryBuffer history;

// BPM processing
volatile unsigned long lastBeatTimeMicros = 0;
volatile unsigned long beatIntervalMicros = 0;
volatile bool newBeatAvailable = false;
int   bpmBuffer[BPM_SAMPLE_SIZE] = {0};
int   bpmBufferIdx = 0;

// Temperature smoothing
float tempBuffer[TEMP_SAMPLE_SIZE] = {0};
int   tempBufferIdx = 0;
bool  tempBufferFull = false;

// Fall detection state machine
enum FallState { FALL_IDLE, FALL_FREEFALL, FALL_IMPACT, FALL_INACTIVITY };
FallState fallState = FALL_IDLE;
unsigned long fallStateTime = 0;
unsigned long fallConfirmedTime = 0;

// Emergency timing
unsigned long lastHeartAlert  = 0;
unsigned long lastTempAlert   = 0;
unsigned long lastFallAlert   = 0;
unsigned long lastEmergencyTime = 0;

// Stats
unsigned long systemStartTime = 0;
unsigned int  totalAlerts     = 0;

// History push interval
unsigned long lastHistoryPush = 0;

// Heartbeat watchdog
unsigned long lastHeartbeatTime = 0;

// ==================== ISR ====================
void IRAM_ATTR heartbeatISR() {
  unsigned long now = micros();
  // Debounce: ignore if < 300 ms since last beat
  if ((now - lastBeatTimeMicros) > 300000UL) {
    beatIntervalMicros = now - lastBeatTimeMicros;
    lastBeatTimeMicros = now;
    newBeatAvailable   = true;
  }
}

// ==================== BPM CALCULATION ====================
float calculateBPM() {
  unsigned long interval = beatIntervalMicros;
  if (interval == 0) return sensor.heartRate;

  // Valid window: 25–220 BPM  (273 ms – 2400 ms)
  if (interval < 272727UL || interval > 2400000UL) return sensor.heartRate;

  float instantBPM = 60000000.0f / (float)interval;
  if (instantBPM < 25.0f || instantBPM > 220.0f) return sensor.heartRate;

  bpmBuffer[bpmBufferIdx] = (int)instantBPM;
  bpmBufferIdx = (bpmBufferIdx + 1) % BPM_SAMPLE_SIZE;

  long  sum   = 0;
  int   count = 0;
  for (int i = 0; i < BPM_SAMPLE_SIZE; i++) {
    if (bpmBuffer[i] > 0) { sum += bpmBuffer[i]; count++; }
  }
  return (count > 0) ? (float)sum / count : sensor.heartRate;
}

// ==================== TEMPERATURE ====================
float readTemperature() {
  ds18b20.requestTemperatures();
  float raw = ds18b20.getTempCByIndex(0);

  if (raw == DEVICE_DISCONNECTED_C || raw < -20.0f || raw > 60.0f) {
    sensorStatus.tempOk = false;
    sensorStatus.errorMessages = "DS18B20 disconnected";
    return sensor.temperature;
  }

  tempBuffer[tempBufferIdx] = raw;
  tempBufferIdx = (tempBufferIdx + 1) % TEMP_SAMPLE_SIZE;
  if (tempBufferIdx == 0) tempBufferFull = true;

  int   n   = tempBufferFull ? TEMP_SAMPLE_SIZE : tempBufferIdx;
  float sum = 0;
  for (int i = 0; i < n; i++) sum += tempBuffer[i];

  sensorStatus.tempOk = true;
  sensorStatus.errorMessages = "";
  return sum / n;
}

// ==================== MPU6050 INIT ====================
bool initMPU6050() {
  Wire.begin(21, 22);
  Wire.setClock(400000);
  delay(150);

  mpu.begin();
  delay(200);
  Serial.println("[MPU] Calibrating gyro offsets (keep still)...");
  mpu.calcGyroOffsets(true);
  delay(500);

  sensorStatus.mpuOk = true;
  Serial.println("[MPU] MPU6050 ready.");
  return true;
}

// ==================== FALL DETECTION (multi-stage) ====================
/*
 * State machine:
 *   IDLE  -> FREEFALL   : accelMag < FREEFALL_THRESHOLD for ≥ 1 sample
 *   FREEFALL -> IMPACT  : accelMag > IMPACT_THRESHOLD within IMPACT_WINDOW ms
 *   FREEFALL -> IDLE    : timed out (IMPACT_WINDOW) without impact  → false alarm
 *   IMPACT -> INACTIVITY: accelMag < INACTIVITY_THRESHOLD for INACTIVITY_WINDOW ms
 *   INACTIVITY -> IDLE  : person moved (accelMag spike) → probably ok
 *   INACTIVITY → CONFIRM: stayed still → FALL CONFIRMED
 */
void updateFallDetection() {
  if (!sensorStatus.mpuOk) return;

  mpu.update();
  sensor.accelX = mpu.getAccX();
  sensor.accelY = mpu.getAccY();
  sensor.accelZ = mpu.getAccZ();
  sensor.gyroX  = mpu.getGyroX();
  sensor.gyroY  = mpu.getGyroY();
  sensor.gyroZ  = mpu.getGyroZ();

  float mag = sqrt(sq(sensor.accelX) + sq(sensor.accelY) + sq(sensor.accelZ));
  sensor.accelMag = mag;

  unsigned long now = millis();

  switch (fallState) {
    // ---- IDLE: watching for free-fall ----
    case FALL_IDLE:
      if (mag < FREEFALL_THRESHOLD) {
        fallState     = FALL_FREEFALL;
        fallStateTime = now;
        Serial.printf("[FALL] Free-fall suspected (mag=%.2f)\n", mag);
      }
      break;

    // ---- FREE-FALL: waiting for impact ----
    case FALL_FREEFALL:
      if (mag > IMPACT_THRESHOLD) {
        fallState     = FALL_IMPACT;
        fallStateTime = now;
        Serial.printf("[FALL] Impact detected after free-fall (mag=%.2f)\n", mag);
      } else if (now - fallStateTime > IMPACT_WINDOW) {
        // Never got the impact – back to idle
        fallState = FALL_IDLE;
        Serial.println("[FALL] Free-fall timeout – no impact, resetting.");
      }
      break;

    // ---- IMPACT: waiting for inactivity ----
    case FALL_IMPACT:
      if (mag < INACTIVITY_THRESHOLD) {
        // Starting to be still – start inactivity timer
        if (fallStateTime == 0 || mag < INACTIVITY_THRESHOLD) {
          fallState     = FALL_INACTIVITY;
          fallStateTime = now;
          Serial.println("[FALL] Post-impact inactivity – confirming fall...");
        }
      } else if (now - fallStateTime > 3000) {
        // Still very active 3 s after impact → person is moving, false alarm
        fallState = FALL_IDLE;
        Serial.println("[FALL] Active movement after impact – probable false alarm.");
      }
      break;

    // ---- INACTIVITY: confirming the fall ----
    case FALL_INACTIVITY:
      if (mag > INACTIVITY_THRESHOLD + 3.0f) {
        // Sudden movement – person got up
        fallState = FALL_IDLE;
        Serial.println("[FALL] Person moved – false alarm cleared.");
      } else if (now - fallStateTime >= INACTIVITY_WINDOW) {
        // Confirmed!
        if (!sensor.fallDetected) {
          sensor.fallDetected    = true;
          sensor.emergencyActive = true;
          fallConfirmedTime      = now;
          totalAlerts++;
          Serial.println("[ALERT] *** FALL CONFIRMED *** Medical assistance may be needed!");
        }
      }
      break;
  }

  // Auto-clear fall alert after FALL_RECOVERY_TIME
  if (sensor.fallDetected && (now - fallConfirmedTime > FALL_RECOVERY_TIME)) {
    sensor.fallDetected = false;
    fallState = FALL_IDLE;
    Serial.println("[FALL] Fall alert auto-cleared (recovery timeout).");
  }
}

// ==================== EMERGENCY LOGIC ====================
void checkEmergencyConditions() {
  unsigned long now = millis();
  bool   newEmergency = false;
  String reason       = "";

  if (sensorStatus.heartbeatOk && sensor.heartRate > 0) {
    if (sensor.heartRate < HEART_RATE_MIN && now - lastHeartAlert > EMERGENCY_COOLDOWN) {
      newEmergency    = true;
      reason          = "LOW HEART RATE: " + String((int)sensor.heartRate) + " BPM";
      lastHeartAlert  = now;
    } else if (sensor.heartRate > HEART_RATE_MAX && now - lastHeartAlert > EMERGENCY_COOLDOWN) {
      newEmergency    = true;
      reason          = "HIGH HEART RATE: " + String((int)sensor.heartRate) + " BPM";
      lastHeartAlert  = now;
    }
  }

  if (sensorStatus.tempOk && sensor.temperature > -50.0f) {
    if (sensor.temperature < TEMP_MIN && now - lastTempAlert > EMERGENCY_COOLDOWN) {
      newEmergency   = true;
      reason         = "LOW TEMPERATURE: " + String(sensor.temperature, 1) + " C";
      lastTempAlert  = now;
    } else if (sensor.temperature > TEMP_MAX && now - lastTempAlert > EMERGENCY_COOLDOWN) {
      newEmergency   = true;
      reason         = "HIGH TEMPERATURE: " + String(sensor.temperature, 1) + " C";
      lastTempAlert  = now;
    }
  }

  if (sensor.fallDetected && now - lastFallAlert > EMERGENCY_COOLDOWN) {
    newEmergency  = true;
    reason        = "FALL DETECTED";
    lastFallAlert = now;
  }

  if (newEmergency) {
    sensor.emergencyActive = true;
    lastEmergencyTime      = now;
    totalAlerts++;
    Serial.println("\n!!! MEDICAL EMERGENCY: " + reason + " !!!\n");
  }

  // Auto-clear emergency when vitals normalise and no fall
  if (sensor.emergencyActive && !sensor.fallDetected &&
      (now - lastEmergencyTime > EMERGENCY_COOLDOWN)) {
    bool ok = true;
    if (sensorStatus.heartbeatOk && sensor.heartRate > 0)
      ok &= (sensor.heartRate >= HEART_RATE_MIN && sensor.heartRate <= HEART_RATE_MAX);
    if (sensorStatus.tempOk && sensor.temperature > -50.0f)
      ok &= (sensor.temperature >= TEMP_MIN && sensor.temperature <= TEMP_MAX);
    if (ok) {
      sensor.emergencyActive = false;
      Serial.println("[INFO] Emergency auto-cleared – vitals normalised.");
    }
  }
}

// ==================== WiFi RECONNECT ====================
void maintainWiFi() {
  if (WiFi.status() != WL_CONNECTED) {
    sensorStatus.wifiOk = false;
    Serial.println("[WiFi] Reconnecting...");
    WiFi.reconnect();
    unsigned long t = millis();
    while (WiFi.status() != WL_CONNECTED && millis() - t < 8000) delay(300);
    if (WiFi.status() == WL_CONNECTED) {
      sensorStatus.wifiOk = true;
      Serial.println("[WiFi] Reconnected: " + WiFi.localIP().toString());
    }
  }
}

