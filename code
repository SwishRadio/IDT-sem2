// ---- Canvas charts ----
function drawChart(canvasId,data,color,minY,maxY,dangerLow,dangerHigh){
  const c=document.getElementById(canvasId);
  if(!c)return;
  const W=c.offsetWidth||c.parentElement.offsetWidth||400;
  const H=120;
  c.width=W;c.height=H;
  const ctx=c.getContext('2d');
  ctx.clearRect(0,0,W,H);

  // Grid lines
  ctx.strokeStyle='rgba(255,255,255,.05)';
  ctx.lineWidth=1;
  for(let i=1;i<4;i++){
    const y=H*i/4;
    ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(W,y);ctx.stroke();
  }

  // Danger zones
  const toY=v=>{
    const range=maxY-minY||1;
    return H - ((v-minY)/range)*H;
  };
  if(dangerHigh<maxY){
    const y=toY(dangerHigh);
    ctx.fillStyle='rgba(248,81,73,.07)';
    ctx.fillRect(0,0,W,y);
  }
  if(dangerLow>minY){
    const y=toY(dangerLow);
    ctx.fillStyle='rgba(88,166,255,.07)';
    ctx.fillRect(0,y,W,H-y);
  }

  // Dotted reference lines
  ctx.setLineDash([4,4]);
  ctx.strokeStyle='rgba(248,81,73,.35)';ctx.lineWidth=1;
  if(dangerHigh<maxY){const y=toY(dangerHigh);ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(W,y);ctx.stroke();}
  ctx.strokeStyle='rgba(88,166,255,.35)';
  if(dangerLow>minY){const y=toY(dangerLow);ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(W,y);ctx.stroke();}
  ctx.setLineDash([]);

  // Line + fill
  const valid=data.filter(v=>v!==null);
  if(valid.length<2)return;
  const pts=[];
  const step=W/(HISTORY-1);
  for(let i=0;i<HISTORY;i++){
    if(data[i]===null)continue;
    pts.push({x:i*step,y:toY(data[i])});
  }

  // Gradient fill
  const grad=ctx.createLinearGradient(0,0,0,H);
  grad.addColorStop(0,color.replace(')',',0.35)').replace('rgb','rgba'));
  grad.addColorStop(1,color.replace(')',',0)').replace('rgb','rgba'));
  ctx.beginPath();
  ctx.moveTo(pts[0].x,H);
  pts.forEach(p=>ctx.lineTo(p.x,p.y));
  ctx.lineTo(pts[pts.length-1].x,H);
  ctx.closePath();
  ctx.fillStyle=grad;
  ctx.fill();

  // Line
  ctx.beginPath();
  pts.forEach((p,i)=>i===0?ctx.moveTo(p.x,p.y):ctx.lineTo(p.x,p.y));
  ctx.strokeStyle=color;
  ctx.lineWidth=2.2;
  ctx.lineJoin='round';
  ctx.stroke();

  // Last point dot
  if(pts.length>0){
    const lp=pts[pts.length-1];
    ctx.beginPath();
    ctx.arc(lp.x,lp.y,4,0,Math.PI*2);
    ctx.fillStyle=color;
    ctx.fill();
  }
}

// ---- Gauge ----
function updateGauge(temp){
  const arc=document.getElementById('gaugeArc');
  const txt=document.getElementById('gaugeTxt');
  if(!arc||!txt)return;
  const circumference=2*Math.PI*54; // 339.3
  const lo=34.0,hi=42.0;
  const pct=Math.max(0,Math.min(1,(temp-lo)/(hi-lo)));
  const offset=circumference*(1-pct);
  arc.style.strokeDashoffset=offset;
  if(temp<TEMP_MIN)arc.style.stroke='#58a6ff';
  else if(temp>TEMP_MAX)arc.style.stroke='#f85149';
  else arc.style.stroke='#3fb950';
  txt.textContent=temp.toFixed(1);
}

