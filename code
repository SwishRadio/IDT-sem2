// ==================== API HANDLERS ====================
void handleAPIData() {
  StaticJsonDocument<512> doc;
  
  doc["bpm"] = (status.heartbeatOk && sensor.heartRate > 0) ? round(sensor.heartRate) : 0;
  doc["temp"] = (status.tempOk && sensor.temperature > -50) ? sensor.temperature : 0;
  doc["fall"] = sensor.fallDetected;
  doc["emergency"] = sensor.emergencyActive;
  doc["heartbeatOk"] = status.heartbeatOk;
  doc["tempOk"] = status.tempOk;
  doc["mpuOk"] = status.mpuOk;
  doc["wifiOk"] = status.wifiOk;
  doc["errorMsg"] = status.errorMessages;
  
  String response;
  serializeJson(doc, response);
  server.send(200, "application/json", response);
}

void handleNeedAssistance() {
  Serial.println("[ALERT] PATIENT REQUESTED MEDICAL ASSISTANCE!");
  sensor.emergencyActive = true;
  
  StaticJsonDocument<64> doc;
  doc["success"] = true;
  String response;
  serializeJson(doc, response);
  server.send(200, "application/json", response);
}

void handleClearEmergency() {
  sensor.emergencyActive = false;
  sensor.fallDetected = false;
  status.errorMessages = "";
  Serial.println("[INFO] Emergency cleared by user response");
  
  StaticJsonDocument<64> doc;
  doc["success"] = true;
  String response;
  serializeJson(doc, response);
  server.send(200, "application/json", response);
}

void setupWebServer() {
  server.on("/", handleRoot);
  server.on("/api/data", handleAPIData);
  server.on("/api/need_assistance", HTTP_POST, handleNeedAssistance);
  server.on("/api/clear_emergency", HTTP_POST, handleClearEmergency);
  server.begin();
  Serial.println("[INFO] Web server started");
}

// ==================== SENSOR READING TASK ====================
void readAllSensors() {
  unsigned long now = millis();
  
  // Process heartbeat
  if (newBeatAvailable) {
    float newBPM = calculateBPM();
    if (newBPM > 0) {
      sensor.heartRate = newBPM;
      status.heartbeatOk = true;
      lastHeartbeatTime = now;
    }
    newBeatAvailable = false;
  } else if (now - lastHeartbeatTime > 3000) {
    // No heartbeat detected for 3 seconds
    if (status.heartbeatOk) {
      status.heartbeatOk = false;
      Serial.println("[WARN] Heartbeat signal lost - check sensor placement");
    }
  }
  
  // Read temperature every 2 seconds
  static unsigned long lastTempRead = 0;
  if (now - lastTempRead >= 2000) {
    sensor.temperature = readTemperature();
    lastTempRead = now;
  }
  
  // Update fall detection
  updateFallDetection();
  
  // Check for emergencies
  checkEmergencyConditions();
}

// ==================== SERIAL DEBUG OUTPUT ====================
void serialDebugOutput() {
  static unsigned long lastOutput = 0;
  unsigned long now = millis();
  
  if (now - lastOutput >= 3000) {
    Serial.println("\n===============================================");
    Serial.println("     IoT HEALTH MONITOR - LIVE DATA");
    Serial.println("===============================================");
    
    // Heart Rate
    Serial.print("Heart Rate: ");
    if (status.heartbeatOk && sensor.heartRate > 0) {
      Serial.printf("%5.0f BPM", sensor.heartRate);
      if (sensor.heartRate < HEART_RATE_MIN) Serial.print(" [LOW]");
      else if (sensor.heartRate > HEART_RATE_MAX) Serial.print(" [HIGH]");
      else Serial.print(" [NORMAL]");
    } else {
      Serial.print("   -- BPM (No Signal)");
    }
    Serial.println();
    
    // Temperature
    Serial.print("Temperature: ");
    if (status.tempOk && sensor.temperature > -50) {
      Serial.printf("%5.1f C", sensor.temperature);
      if (sensor.temperature < TEMP_MIN) Serial.print(" [LOW]");
      else if (sensor.temperature > TEMP_MAX) Serial.print(" [HIGH]");
      else Serial.print(" [NORMAL]");
    } else {
      Serial.print("    -- C (Sensor Error)");
    }
    Serial.println();
    
    // Accelerometer
    Serial.printf("Accelerometer: X=%6.2f  Y=%6.2f  Z=%6.2f m/s^2\n", 
                  sensor.accelX, sensor.accelY, sensor.accelZ);
    
    // Fall Status
    Serial.print("Fall Status: ");
    if (sensor.fallDetected) {
      Serial.print("FALL DETECTED!");
    } else {
      Serial.print("No Fall Detected");
    }
    Serial.println();
    
    // Emergency Status
    Serial.print("Emergency: ");
    if (sensor.emergencyActive) {
      Serial.print("ACTIVE - Medical assistance may be needed");
    } else {
      Serial.print("No Active Emergencies");
    }
    Serial.println();
    
    // WiFi Status
    Serial.print("WiFi: ");
    Serial.print(WiFi.status() == WL_CONNECTED ? "Connected" : "Disconnected");
    Serial.print(" | IP: ");
    Serial.println(WiFi.localIP());
    
    Serial.println("===============================================\n");
    lastOutput = now;
  }
}

// ==================== SETUP ====================
void setup() {
  Serial.begin(115200);
  delay(100);
  Serial.println("\n\n========================================");
  Serial.println("IoT Health Monitoring System Starting...");
  Serial.println("========================================\n");
  
  // Initialize Heartbeat Sensor (GPIO34)
  pinMode(HEARTBEAT_PIN, INPUT_PULLUP);
  attachInterrupt(digitalPinToInterrupt(HEARTBEAT_PIN), heartbeatISR, RISING);
  Serial.println("[OK] Heartbeat sensor initialized on GPIO34");
  
  // Initialize DS18B20
  pinMode(ONE_WIRE_BUS, INPUT_PULLUP);

  ds18b20.begin();

  Serial.println("[OK] DS18B20 initialized on GPIO4 with internal pullup");
  
  // Initialize MPU6050
  if (!initMPU6050()) {
    Serial.println("[WARN] MPU6050 not detected - fall detection disabled");
  }
  
  // Connect to WiFi
  Serial.printf("\n[WiFi] Connecting to %s", ssid);
  WiFi.begin(ssid, password);
  
  int attempts = 0;
  while (WiFi.status() != WL_CONNECTED && attempts < 40) {
    delay(500);
    Serial.print(".");
    attempts++;
  }
  
  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("\n[WiFi] Connected successfully!");
    Serial.printf("[WiFi] IP Address: %s\n", WiFi.localIP().toString().c_str());
    status.wifiOk = true;
  } else {
    Serial.println("\n[WiFi] Failed to connect! Check credentials.");
    status.wifiOk = false;
  }
  
  // Setup Web Server
  setupWebServer();
  
  Serial.println("\n[OK] System ready!");
  Serial.println("[INFO] Access the dashboard at: http://" + WiFi.localIP().toString());
  Serial.println("[INFO] Monitoring started...\n");
}

// ==================== LOOP ====================
void loop() {
  static unsigned long lastSensorRead = 0;
  unsigned long now = millis();
  
  // Read sensors every 100ms
  if (now - lastSensorRead >= 100) {
    readAllSensors();
    lastSensorRead = now;
  }
  
  // Handle web requests
  server.handleClient();
  
  // Serial debugging output
  serialDebugOutput();
  
  delay(10);  // Small delay for stability
}
