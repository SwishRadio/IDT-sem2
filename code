// ==================== API: /api/data ====================
void handleAPIData() {
  StaticJsonDocument<512> doc;
  doc["bpm"]         = (sensorStatus.heartbeatOk && sensor.heartRate > 0) ? (int)round(sensor.heartRate) : 0;
  doc["temp"]        = (sensorStatus.tempOk && sensor.temperature > -50.0f) ? sensor.temperature : 0.0f;
  doc["fall"]        = sensor.fallDetected;
  doc["emergency"]   = sensor.emergencyActive;
  doc["heartbeatOk"] = sensorStatus.heartbeatOk;
  doc["tempOk"]      = sensorStatus.tempOk;
  doc["mpuOk"]       = sensorStatus.mpuOk;
  doc["wifiOk"]      = sensorStatus.wifiOk;
  doc["errorMsg"]    = sensorStatus.errorMessages;
  doc["ax"]          = sensor.accelX;
  doc["ay"]          = sensor.accelY;
  doc["az"]          = sensor.accelZ;
  doc["amag"]        = sensor.accelMag;
  doc["uptime"]      = (millis() - systemStartTime) / 1000;
  doc["alerts"]      = totalAlerts;

  String out;
  serializeJson(doc, out);
  server.send(200, "application/json", out);
}

// ==================== API: /api/history ====================
void handleAPIHistory() {
  // Build compact JSON arrays for the graph
  String bpmArr = "[";
  String tmpArr = "[";

  int start = (history.count < HISTORY_SIZE) ? 0 : history.head;
  for (int i = 0; i < history.count; i++) {
    int idx = (start + i) % HISTORY_SIZE;
    if (i > 0) { bpmArr += ","; tmpArr += ","; }
    if (history.bpm[idx] > 0)  bpmArr += String((int)history.bpm[idx]);
    else                       bpmArr += "null";
    if (history.temp[idx] > 0) tmpArr += String(history.temp[idx], 1);
    else                       tmpArr += "null";
  }
  bpmArr += "]";
  tmpArr += "]";

  server.send(200, "application/json", "{\"bpm\":" + bpmArr + ",\"temp\":" + tmpArr + "}");
}

// ==================== API: Assistance / Clear ====================
void handleNeedAssistance() {
  Serial.println("[ALERT] PATIENT REQUESTED MEDICAL ASSISTANCE!");
  sensor.emergencyActive = true;
  totalAlerts++;
  server.send(200, "application/json", "{\"success\":true}");
}

void handleClearEmergency() {
  sensor.emergencyActive = false;
  sensor.fallDetected    = false;
  fallState              = FALL_IDLE;
  sensorStatus.errorMessages = "";
  Serial.println("[INFO] Emergency cleared by user.");
  server.send(200, "application/json", "{\"success\":true}");
}

void setupWebServer() {
  server.on("/",                    handleRoot);
  server.on("/api/data",            handleAPIData);
  server.on("/api/history",         handleAPIHistory);
  server.on("/api/need_assistance", HTTP_POST, handleNeedAssistance);
  server.on("/api/clear_emergency", HTTP_POST, handleClearEmergency);
  server.begin();
  Serial.println("[Web] Server started");
}

// ==================== SENSOR LOOP ====================
void readAllSensors() {
  unsigned long now = millis();

  // --- Heartbeat ---
  if (newBeatAvailable) {
    float newBPM = calculateBPM();
    if (newBPM > 0) {
      sensor.heartRate = newBPM;
      sensorStatus.heartbeatOk = true;
      lastHeartbeatTime = now;
    }
    newBeatAvailable = false;
  } else if (now - lastHeartbeatTime > 3500) {
    if (sensorStatus.heartbeatOk) {
      sensorStatus.heartbeatOk = false;
      Serial.println("[WARN] Heartbeat signal lost – check sensor.");
    }
  }

  // --- Temperature (every 2 s) ---
  static unsigned long lastTempRead = 0;
  if (now - lastTempRead >= 2000) {
    sensor.temperature = readTemperature();
    lastTempRead = now;
  }

  // --- Fall detection ---
  updateFallDetection();

  // --- Emergency check ---
  checkEmergencyConditions();

  // --- Push to history every 1 s ---
  if (now - lastHistoryPush >= 1000) {
    float b = (sensorStatus.heartbeatOk && sensor.heartRate > 0) ? sensor.heartRate : 0;
    float t = (sensorStatus.tempOk && sensor.temperature > -50.0f) ? sensor.temperature : 0;
    history.push(b, t);
    lastHistoryPush = now;
  }
}

// ==================== SERIAL DEBUG ====================
void serialDebug() {
  static unsigned long last = 0;
  unsigned long now = millis();
  if (now - last < 4000) return;
  last = now;

  Serial.println("\n============ HEALTH MONITOR ============");
  Serial.printf("Heart Rate  : %5.0f BPM  [%s]\n",
    sensor.heartRate, sensorStatus.heartbeatOk ? "OK" : "NO SIGNAL");
  Serial.printf("Temperature : %5.1f C    [%s]\n",
    sensor.temperature, sensorStatus.tempOk ? "OK" : "ERROR");
  Serial.printf("Accel Mag   : %5.2f m/s²\n", sensor.accelMag);
  Serial.printf("Fall State  : %d  Detected: %s\n",
    (int)fallState, sensor.fallDetected ? "YES" : "No");
  Serial.printf("Emergency   : %s\n", sensor.emergencyActive ? "ACTIVE" : "None");
  Serial.printf("WiFi        : %s  IP: %s\n",
    WiFi.status()==WL_CONNECTED?"Connected":"Offline",
    WiFi.localIP().toString().c_str());
  Serial.println("========================================\n");
}

// ==================== SETUP ====================
void setup() {
  Serial.begin(115200);
  delay(150);
  Serial.println("\n========================================");
  Serial.println("  IoT Health Monitoring System v2.0");
  Serial.println("========================================\n");

  systemStartTime = millis();

  // Heartbeat ISR
  pinMode(HEARTBEAT_PIN, INPUT_PULLUP);
  attachInterrupt(digitalPinToInterrupt(HEARTBEAT_PIN), heartbeatISR, RISING);
  Serial.println("[OK] Heartbeat sensor on GPIO34");

  // DS18B20
  pinMode(ONE_WIRE_BUS, INPUT_PULLUP);
  ds18b20.begin();
  Serial.println("[OK] DS18B20 on GPIO4");

  // MPU6050
  if (!initMPU6050()) {
    Serial.println("[WARN] MPU6050 not found – fall detection disabled.");
  }

  // WiFi
  Serial.printf("[WiFi] Connecting to %s", ssid);
  WiFi.begin(ssid, password);
  int tries = 0;
  while (WiFi.status() != WL_CONNECTED && tries++ < 40) {
    delay(500); Serial.print(".");
  }
  if (WiFi.status() == WL_CONNECTED) {
    Serial.printf("\n[WiFi] Connected! IP: %s\n", WiFi.localIP().toString().c_str());
    sensorStatus.wifiOk = true;
  } else {
    Serial.println("\n[WiFi] Failed – will retry in loop.");
  }

  setupWebServer();

  Serial.println("\n[OK] System ready.");
  Serial.printf("[INFO] Dashboard: http://%s\n\n", WiFi.localIP().toString().c_str());
}

// ==================== LOOP ====================
void loop() {
  static unsigned long lastRead    = 0;
  static unsigned long lastWifiChk = 0;
  unsigned long now = millis();

  // Sensors at 100 ms cadence
  if (now - lastRead >= 100) {
    readAllSensors();
    lastRead = now;
  }

  // Web server
  server.handleClient();

  // WiFi watchdog every 30 s
  if (now - lastWifiChk >= 30000) {
    maintainWiFi();
    lastWifiChk = now;
  }

  // Serial debug
  serialDebug();

  delay(5);
}
